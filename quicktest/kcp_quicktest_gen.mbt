///|
/// 命令/响应词表(名字来自源表 [[commands]])
priv enum SymCmd {
  Send(Int64)
  Tick
  Deliver
  Drop
} derive(Debug)

///|
priv enum SymResp {
  Ok
} derive(Debug)

///|
/// 账本镜(Model;Int64 守恒计数域 + 双执行对账粘滞旗)
priv struct Ledger {
  bytes_sent : Int64
  bytes_delivered : Int64
  seq_sent : Int64
  seq_delivered_last : Int64
  delivery_ordered : Bool
  conservation_held : Bool
} derive(Debug)

///|
fn kcp_quick_ledger0() -> Ledger {
  {
    bytes_sent: 0L,
    bytes_delivered: 0L,
    seq_sent: 0L,
    seq_delivered_last: 0L,
    delivery_ordered: true,
    conservation_held: true,
  }
}

///|
/// SUT:会话对 + 双向线材 + 共享钟 + 真值账(纯形:零 IO 零时钟)
priv struct Harness {
  client : @kcp.KcpSession
  server : @kcp.KcpSession
  wire_c2s : Array[FixedArray[Byte]]
  wire_s2c : Array[FixedArray[Byte]]
  mut now : Int32
  mut next_seq : Int64
  mut sent_bytes : Int64
  mut delivered_bytes : Int64
  mut last_delivered : Int64
  mut ordered : Bool
}

///|
/// 泵调参:interval 压到 step_ms 之下,每拍必 flush(K8 泵坑:缺省
/// 100ms 十拍一发 + epoch 头零 flush)
fn kcp_quick_harness_new(
  conv : Int32,
  high_water : Int32,
  interval_ms : Int32,
) -> Harness {
  let client = @kcp.KcpSession::new(conv, high_water)
  let server = @kcp.KcpSession::new(conv, high_water)
  client.kcp.interval = interval_ms
  server.kcp.interval = interval_ms
  {
    client,
    server,
    wire_c2s: [],
    wire_s2c: [],
    now: 0,
    next_seq: 1L,
    sent_bytes: 0L,
    delivered_bytes: 0L,
    last_delivered: 0L,
    ordered: true,
  }
}

///|
/// 载荷:4B 大端序号戳 + 填充(收侧据此验序)
fn kcp_quick_stamp(seq : Int64, n : Int64) -> FixedArray[Byte] {
  let s = seq.to_int()
  let payload : FixedArray[Byte] = FixedArray::make(
    n.to_int(),
    (s % 251).to_byte(),
  )
  payload[0] = ((s >> 24) & 0xFF).to_byte()
  payload[1] = ((s >> 16) & 0xFF).to_byte()
  payload[2] = ((s >> 8) & 0xFF).to_byte()
  payload[3] = (s & 0xFF).to_byte()
  payload
}

///|
/// 收侧读序号戳(首 4B 大端)
fn kcp_quick_read_seq(payload : FixedArray[Byte]) -> Int64 {
  let hi = (payload[0].to_int() << 24) | (payload[1].to_int() << 16)
  let lo = (payload[2].to_int() << 8) | payload[3].to_int()
  (hi | lo).to_int64()
}

///|
/// 静息判据:双向线空 + 发窗排空 ⇒ 所发字节皆达对端
fn kcp_quick_quiescent(h : Harness) -> Bool {
  h.wire_c2s.length() == 0 &&
  h.wire_s2c.length() == 0 &&
  h.client.kcp.waitsnd() == 0
}

///|
/// 执行面:排线(数据方向→server,ACK 方向→client)+ 收货验序记账
fn kcp_quick_deliver(h : Harness) -> Unit {
  let c2s : Array[FixedArray[Byte]] = []
  for frame in h.wire_c2s {
    c2s.push(frame)
  }
  h.wire_c2s.clear()
  for frame in c2s {
    let _ = h.server.on_datagram(frame)
  }
  let s2c : Array[FixedArray[Byte]] = []
  for frame in h.wire_s2c {
    s2c.push(frame)
  }
  h.wire_s2c.clear()
  for frame in s2c {
    let _ = h.client.on_datagram(frame)
  }
  let mut go = true
  while go {
    match h.server.poll_message() {
      Some(msg) => {
        h.delivered_bytes = h.delivered_bytes + msg.length().to_int64()
        let seq = kcp_quick_read_seq(msg)
        if seq <= h.last_delivered {
          h.ordered = false
        }
        h.last_delivered = seq
      }
      None => go = false
    }
  }
}

///|
/// statem(harness 闭包捕获:qcs 契约里 transition_concrete 无 system 入参,
/// 观测面只能捕获;harness 计数跨用例持续,序号戳单调不回绕)
fn kcp_quick_statem(
  harness : Harness,
) -> @qcs.StateMachine[
  Ledger,
  Ledger,
  SymCmd,
  SymCmd,
  SymResp,
  SymResp,
  Unit,
  Harness,
] {
  @qcs.StateMachine::new(
    init_symbolic_model=fn() { kcp_quick_ledger0() },
    init_concrete_model=fn() { kcp_quick_ledger0() },
    init_system=fn() { harness },
    generator=fn(_model, _size, rand) {
      // splitmix next_int 可返负 Int:先掩码取正再取模(负长度 FixedArray::make 即 abort)
      let roll = (@splitmix.RandomState::next_int(rand) & 0x7FFFFFFF) % 100
      if roll < 40 {
        Some(
          Send(
            ((@splitmix.RandomState::next_int(rand) & 0x7FFFFFFF) % 61 + 4).to_int64(),
          ),
        )
      } else if roll < 65 {
        Some(Tick)
      } else if roll < 90 {
        Some(Deliver)
      } else {
        Some(Drop)
      }
    },
    mock=fn(_model, _cmd, gensym) { (SymResp::Ok, gensym) },
    response_vars=fn(_resp) { [] },
    transition_symbolic=fn(model, cmd, _resp) {
      match cmd {
        Send(n) =>
          {
            ..model,
            bytes_sent: model.bytes_sent + n,
            seq_sent: model.seq_sent + 1L,
          }
        Tick => model
        Deliver => model
        Drop => model
      }
    },
    transition_concrete=fn(model, cmd, _resp) {
      let next = match cmd {
        Send(_) =>
          {
            ..model,
            bytes_sent: harness.sent_bytes,
            seq_sent: harness.next_seq - 1L,
          }
        Tick => model
        Deliver =>
          {
            ..model,
            bytes_delivered: harness.delivered_bytes,
            seq_delivered_last: harness.last_delivered,
            delivery_ordered: model.delivery_ordered && harness.ordered,
          }
        Drop => model
      }
      if kcp_quick_quiescent(harness) &&
        harness.sent_bytes != harness.delivered_bytes {
        { ..next, conservation_held: false, }
      } else {
        next
      }
    },
    invariant=fn(model) {
      @qcs.Logic::boolean(
        model.bytes_sent >= 0L &&
        model.bytes_delivered >= 0L &&
        model.seq_sent >= 0L &&
        model.seq_delivered_last >= 0L &&
        model.delivery_ordered &&
        model.conservation_held,
      )
    },
    postcondition=fn(_model, _cmd, _resp) {
      @qcs.Logic::boolean(true) // 主断言在 invariant(守恒/有序)
    },
    shrinker=fn(_model, cmd) {
      match cmd {
        Send(n) => if n > 4L { [Send(4L)] } else { [] }
        _ => []
      }
    },
    reify_command=fn(cmd, _env) { Ok(cmd) },
    run_command=fn(cmd, system) {
      match cmd {
        Send(n) => {
          let rc = system.client.send_message(
            kcp_quick_stamp(system.next_seq, n),
          )
          if rc >= 0 {
            system.sent_bytes = system.sent_bytes + n
            system.next_seq = system.next_seq + 1L
          }
          SymResp::Ok
        }
        Tick => {
          system.now = system.now + 50
          for frame in system.client.tick(system.now) {
            system.wire_c2s.push(frame)
          }
          for frame in system.server.tick(system.now) {
            system.wire_s2c.push(frame)
          }
          SymResp::Ok
        }
        Deliver => {
          kcp_quick_deliver(system)
          SymResp::Ok
        }
        Drop => {
          system.wire_c2s.clear()
          system.wire_s2c.clear()
          SymResp::Ok
        }
      }
    },
    bind_response=fn(_sym, _con, env) { Ok(env) },
    cleanup=fn(_model, _system) { () },
    command_name=fn(cmd) {
      match cmd {
        Send(n) => "Send(\{n})"
        Tick => "Tick"
        Deliver => "Deliver"
        Drop => "Drop"
      }
    },
    label=fn(_model, _cmd, _resp) { [] },
  )
}

///|
/// RunConfig(源表 [random_check] 映射)
fn kcp_quick_run_config() -> @qcs.RunConfig {
  {
    seed: 20261027UL,
    cases: 8,
    max_commands: 16,
    size: 20,
    max_tries: 20,
    shrink: true,
    max_shrinks: 30,
    max_shrink_rounds: 10,
    required_labels: [],
    required_command_names: [],
  }
}

///|
/// K10 quicktest 属性测试(qcs assert_check;shrink 收敛报告白得)
test "K10 KCP quicktest:随机 Send×Tick×Deliver×Drop 序列下守恒/有序(shrink 收敛)" {
  let harness = kcp_quick_harness_new(7, 4096, 20)
  let sm = kcp_quick_statem(harness)
  let _ = @qcs.assert_check(sm, config=kcp_quick_run_config())
}
